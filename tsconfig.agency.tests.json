{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": false
  },
  "include": ["tests/agency/**/*.ts", "vitest.agency.config.mts", "playwright.agency.config.ts"],
  "exclude": ["node_modules", ".agency"]
}
